# Created from my starship.toml

_B_RESET='\[\e[0m\]'
_B_BLUE='\[\e[1;34m\]'
_B_GREEN='\[\e[1;32m\]'
_B_RED='\[\e[1;31m\]'
_B_CYAN='\[\e[1;36m\]'
_B_YELLOW='\[\e[1;33m\]'
_B_PURPLE='\[\e[1;35m\]'
_B_GRAY='\[\e[90m\]'
_B_BOLD='\[\e[1m\]'
_B_ITALIC='\[\e[3m\]'

__bash_username() {
	if (( EUID == 0 )); then
		printf '%s' "${_B_RED}${USER:-root}${_B_RESET}"
	else
		printf '%s' "${_B_BLUE}${USER:-$(id -un)}${_B_RESET}"
	fi
}

__bash_hostname() {
	local host
	host="${HOSTNAME:-$(hostname)}"
	host="${host%%.*}"

	if [[ -n "${SSH_CONNECTION:-}${SSH_TTY:-}${SSH_CLIENT:-}" ]]; then
		printf ' '
	fi

	printf '@ %s%s%s' "${_B_BLUE}${_B_BOLD}" "$host" "$_B_RESET"
}

__bash_directory() {
	local dir git_root

	if [[ "$PWD" == "$HOME" ]]; then
		dir="~"
	elif [[ "$PWD" == "$HOME/"* ]]; then
		dir="~${PWD#"$HOME"}"
	else
		dir="$PWD"
	fi

	if git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
		if [[ "$PWD" == "$git_root" ]]; then
			dir="$(basename "$git_root")"
		elif [[ "$PWD" == "$git_root/"* ]]; then
			dir="$(basename "$git_root")/${PWD#"$git_root"/}"
		fi
	fi

	if (( ${#dir} > 45 )); then
		dir="…${dir: -42}"
	fi

	local readonly_mark=''
	[[ ! -w "$PWD" ]] && readonly_mark=' 󰌾'

	printf '%s%s%s%s' \
		"${_B_GREEN}${_B_BOLD}${_B_ITALIC}" \
		"$dir" "$readonly_mark" "$_B_RESET"
}

__bash_git() {
	local branch upstream line xy ahead behind
	local staged=0 unstaged=0 untracked=0
	local git_status=''

	branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" ||
		branch="$(git rev-parse --short HEAD 2>/dev/null)" ||
		return

	while IFS= read -r line; do
		xy="${line:0:2}"

		if [[ "$xy" == "??" ]]; then
			untracked=1
		else
			[[ "${xy:0:1}" != " " ]] && staged=1
			[[ "${xy:1:1}" != " " ]] && unstaged=1
		fi
	done < <(git status --porcelain=v1 --untracked-files=normal 2>/dev/null)

	(( staged ))   && git_status+='✚'
	(( unstaged )) && git_status+='!'
	(( untracked )) && git_status+='?'

	upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"

	if [[ -n "$upstream" ]]; then
		read -r behind ahead < <(
			git rev-list --left-right --count "${upstream}...HEAD" 2>/dev/null
		)

		if (( ${ahead:-0} > 0 && ${behind:-0} > 0 )); then
			git_status+='⇕'
		else
			(( ${ahead:-0} > 0 )) && git_status+='⇡'
			(( ${behind:-0} > 0 )) && git_status+='⇣'
		fi
	fi

	printf ' %s %s%s' "$_B_PURPLE" "$branch" "$_B_RESET"

	[[ -n "$git_status" ]] &&
		printf ' %s[%s]%s' "$_B_RED" "$git_status" "$_B_RESET"
}

__bash_cloud() {
	[[ -n "${AWS_PROFILE:-}${AWS_DEFAULT_PROFILE:-}" ]] &&
		printf '  %s%s%s' \
			"$_B_YELLOW" "${AWS_PROFILE:-$AWS_DEFAULT_PROFILE}" "$_B_RESET"

	[[ -n "${AZURE_SUBSCRIPTION_NAME:-}" ]] &&
		printf '  %s%s%s' \
			"$_B_CYAN" "$AZURE_SUBSCRIPTION_NAME" "$_B_RESET"

	[[ -n "${CLOUDSDK_CORE_PROJECT:-}" ]] &&
		printf ' 󱇶 %s%s%s' \
			"$_B_CYAN" "$CLOUDSDK_CORE_PROJECT" "$_B_RESET"

	[[ -n "${KUBECONFIG:-}" || -n "${KUBERNETES_SERVICE_HOST:-}" ]] &&
		printf ' 󱃾 %s%s%s' \
			"$_B_CYAN" "${KUBE_CONTEXT:-k8s}" "$_B_RESET"
}

__bash_runtime() {
	local f name icon
	local -a files=(
		Cargo.toml rust-project.json
		go.mod
		package.json bun.lock bun.lockb
		deno.json deno.jsonc
		pyproject.toml requirements.txt setup.py
		Pipfile
		Gemfile
		composer.json
		pom.xml build.gradle build.gradle.kts
		settings.gradle settings.gradle.kts
		*.sln *.csproj
		mix.exs
		pubspec.yaml
		Package.swift
		CMakeLists.txt
		Makefile
		flake.nix shell.nix
		terraform.tf
		Chart.yaml
		Dockerfile
		*.cabal
		*.hs
		*.lua
		*.zig
		*.nim
		*.ex
		*.exs
		*.dart
		*.ipynb
	)

	if [[ -n "${CONDA_DEFAULT_ENV:-}" ]]; then
		printf '  %s' "$CONDA_DEFAULT_ENV"
	elif [[ -n "${VIRTUAL_ENV:-}" ]]; then
		printf '  %s' "$(basename "$VIRTUAL_ENV")"
	elif [[ -n "${PIXI_PROJECT_NAME:-}" ]]; then
		printf ' 󰏗 %s' "$PIXI_PROJECT_NAME"
	fi

	for f in "${files[@]}"; do
		[[ -f "$f" ]] || continue

		case "$f" in
			Cargo.toml|rust-project.json)
				icon='󱘗'; name='Rust' ;;
			go.mod)
				icon=''; name='Go' ;;
			package.json)
				icon=''; name='Node.js' ;;
			bun.lock|bun.lockb)
				icon=''; name='Bun' ;;
			deno.json|deno.jsonc)
				icon=''; name='Deno' ;;
			pyproject.toml|requirements.txt|setup.py|Pipfile)
				icon=''; name='Python' ;;
			Gemfile)
				icon=''; name='Ruby' ;;
			composer.json)
				icon=''; name='PHP' ;;
			pom.xml|build.gradle|build.gradle.kts|settings.gradle|settings.gradle.kts)
				icon=''; name='Java' ;;
			*.sln|*.csproj)
				icon=''; name='.NET' ;;
			mix.exs|*.ex|*.exs)
				icon=''; name='Elixir' ;;
			pubspec.yaml)
				icon=''; name='Dart' ;;
			Package.swift)
				icon=''; name='Swift' ;;
			CMakeLists.txt|Makefile)
				icon=''; name='C/CMake' ;;
			flake.nix|shell.nix)
				icon=''; name='Nix' ;;
			terraform.tf)
				icon=''; name='Terraform' ;;
			Chart.yaml)
				icon=''; name='Helm' ;;
			Dockerfile)
				icon=''; name='Docker' ;;
			*.cabal|*.hs)
				icon=''; name='Haskell' ;;
			*.lua)
				icon=''; name='Lua' ;;
			*.zig)
				icon=''; name='Zig' ;;
			*.nim)
				icon=''; name='Nim' ;;
			*.dart)
				icon=''; name='Dart' ;;
			*.ipynb)
				icon=''; name='Notebook' ;;
			*)
				continue ;;
		esac

		printf ' %s %s' "$icon" "$name"
		break
	done

	[[ -n "${DIRENV_DIR:-}" ]] && printf '  direnv'
	[[ -n "${IN_NIX_SHELL:-}" ]] && printf '  nix-shell'
	[[ -n "${SHLVL:-}" ]] && (( SHLVL > 1 )) &&
		printf ' 󰹍 %s' "$SHLVL"
}

__bash_os() {
	case "$(uname -s 2>/dev/null)" in
		Linux)
			if [[ -r /etc/os-release ]]; then
				. /etc/os-release
				case "${ID:-linux}" in
					arch|endeavouros|cachyos) printf '' ;;
					debian)                   printf '' ;;
					ubuntu)                   printf '' ;;
					fedora)                   printf '' ;;
					alpine)                   printf '' ;;
					nixos)                    printf '' ;;
					manjaro)                  printf '' ;;
					opensuse*|opensuse-tumbleweed) printf '' ;;
					kali)                     printf '' ;;
					linuxmint)                printf '' ;;
					*)
						case "${ID_LIKE:-}" in
							*debian*) printf '' ;;
							*rhel*|*fedora*) printf '' ;;
							*) printf '' ;;
						esac ;;
				esac
			else
				printf ''
			fi
			;;
		Darwin)  printf '' ;;
		FreeBSD) printf '' ;;
		OpenBSD) printf '' ;;
		*)       printf '' ;;
	esac
}

__bash_prompt() {
	local last_status=$?
	local status_color="$_B_RESET"
	local os

	(( last_status != 0 )) && status_color="$_B_RED"

	PS1="$(__bash_username) "
	PS1+="$(__bash_hostname) "
	PS1+="$(__bash_directory)"
	PS1+="$(__bash_git)"
	PS1+="$(__bash_cloud)"
	PS1+="$(__bash_runtime)"

	PS1+="\n${status_color}\$${_B_RESET} "

	return 0
}

PROMPT_COMMAND='printf "\n"; __bash_prompt'
