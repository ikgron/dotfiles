# Easier navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~"
alias -- -="cd -"

# Shortcuts
alias dl="cd ~/Downloads"
alias dm="cd ~/Documents"
alias dt="cd ~/Desktop"
alias p="cd ~/Projects"
alias d="cd ~/Projects/dotfiles"

# Git
alias g="git"

# Actually clear terminal
alias cls="clear && printf '\e[3J'"

# Use eza if available; use GNU ls as fallback (gls on macOS, ls on Linux)
if command -v eza &>/dev/null; then
    # ls with eza (color, icons, directories first, type indicators, sorted by extension)
    alias ls="eza --color=auto --icons=always --group-directories-first --classify=auto --sort=extension -A"

    # ls -la with eza (long, octal permissions, suppress permissions/user columns)
    alias la="eza --color=auto --icons=always --group-directories-first --classify=auto --sort=extension -a -l --octal-permissions --no-permissions --no-user --header"

elif command -v gls &>/dev/null; then
    alias ls="gls --color=auto --group-directories-first -XFA"
    alias la="gls --color=auto --group-directories-first -XFlA"

else
    alias ls="ls --color=auto --group-directories-first -XFA"
    alias la="ls --color=auto --group-directories-first -XFlA"
fi

# Enable aliases to be sudo’ed
alias sudo="sudo "

# Reload the shell
alias reload="source ~/.bash_profile"

# Print each PATH entry on a separate line
alias path='tr ":" "\n" <<< "$PATH"'

# Fastfetch
alias ff="cls && printf '\n\n' && fastfetch"

# OS specific aliases
if [[ "$OSTYPE" == darwin* ]]; then
    # Get macOS Software Updates and update Homebrew
    alias update="sudo softwareupdate -i -a && brew update && brew upgrade && brew cleanup"

    # Recursively delete `.DS_Store` files
    alias cleanup="find . -type f -name '*.DS_Store' -ls -delete"

    # MacOS has no `sha1sum`, so use `shasum` as a fallback
    command -v sha1sum >/dev/null || alias sha1sum="shasum"

    # Brew uninstall and purge all cask files
    alias brm="brew rm --zap"

    # Better `stat`
    alias stat="stat -x"

elif [[ "$OSTYPE" == linux* ]]; then
    # Update apt packages, flatpak packages, and cleanup unneeded files
    alias update="sudo apt update && sudo apt full-upgrade -y && sudo apt autoremove -y && flatpak update && flatpak uninstall --unused -y"

    # Completely uninstall apt app
    aptrm() {
        sudo apt purge --autoremove -y "$1" && sudo apt clean
    }

    # Completely uninstall flatpak app
    fprm() {
        flatpak uninstall --delete-data -y "$1" && flatpak uninstall --unused -y
    }
fi
