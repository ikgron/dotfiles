theme = Atom One Dark

# Set font and font size
font-family = "FiraCode Nerd Font Mono"
font-size = 16

# Set window settings
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true
window-save-state = always

# Use system default bash
command = /usr/bin/env bash

# Copy selected text to clipboard
copy-on-select = clipboard

# Close app after last surface/window is closed
quit-after-last-window-closed = true

# macOS only:
# Enable secure input and hide icon
macos-auto-secure-input = true
macos-secure-input-indication = false

# Linux only:
# Remove annoying close prompt
confirm-close-surface = false

# ctrl+shift+w to close surface, not entire tab
keybind = ctrl+shift+w=close_surface

# Single instance mode:
gtk-single-instance = true
