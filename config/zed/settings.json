// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Appearance
  "theme": {
    "light": "One Dark",
    "dark": "One Dark Pro",
  },
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "icon_theme": "Material Icon Theme",
  // Editor
  "format_on_save": "on",
  "colorize_brackets": true,
  "soft_wrap": "editor_width",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  // Tabs
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  // Title bar
  "title_bar": {
    "show_sign_in": false,
  },
  // Status bar
  "status_bar": {
    "cursor_position_button": false,
  },
  // Panels
  "project_panel": {
    "dock": "left",
    "hide_root": true,
  },
  "git_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  // Terminal
  "terminal": {
    "copy_on_select": true,
    "button": false,
  },
  // Privacy
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // Extensions
  "auto_install_extensions": {
    "git-firefly": true,
    "material-icon-theme": true,
    "one-dark-pro": true,
    "toml": true,
  },
  // File types
  "file_types": {
    "Git Config": ["config.local", "config"],
    "Git Ignore": ["ignore"],
    "Shell Script": [".aliases", ".exports", ".inputrc", "Brewfile"],
    "TOML": ["config.ghostty"],
  },
}
