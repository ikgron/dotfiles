// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Appearance
  "proxy": "",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark Pro",
  },
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "icon_theme": "Material Icon Theme",
  "base_keymap": "VSCode",
  // Editor
  "soft_wrap": "editor_width",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  // Tabs
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  // Title bar
  "title_bar": {
    "show_sign_in": false,
  },
  // Status bar
  "status_bar": {
    "cursor_position_button": false,
    "line_endings_button": false,
  },
  // Panels
  "project_panel": {
    "dock": "left",
    "hide_root": true,
  },
  "git_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  // Terminal
  "terminal": {
    "button": false,
    "font_family": "FiraCode Nerd Font Mono",
  },
  // Privacy
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // Extensions
  "auto_install_extensions": {
    "git-firefly": true,
    "html": true,
    "material-icon-theme": true,
    "one-dark-pro": true,
    "toml": true,
  },
  // File types
  "file_types": {
    "Git Config": ["config.local", "config"],
    "Git Ignore": ["ignore"],
    "Shell Script": [
      ".aliases",
      ".exports",
      ".inputrc",
      "Brewfile", // IDK I just want some color
    ],
    "TOML": ["config.ghostty"],
  },
}
