# Top-level EditorConfig
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

[*.{sh,bash}]
indent_size = 4

[{.aliases,.bash_profile,.bashrc,.exports,.inputrc}]
indent_size = 4

[*.{json,jsonc,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
